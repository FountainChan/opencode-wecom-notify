{
  "name": "opencode-wecom-ping",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenCode plugin: push WeChat Work (企业微信) notifications on reply complete / error / permission request",
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "node --check src/index.js && node scripts/test-flow.js",
